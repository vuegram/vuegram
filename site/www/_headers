# Response headers for vuegram.com (Cloudflare Workers static assets read this file).
# No cookies, no analytics: the only outside requests are Google Fonts and GitHub's public API.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://api.github.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/styles.css
  Cache-Control: public, max-age=3600

/main.js
  Cache-Control: public, max-age=3600
