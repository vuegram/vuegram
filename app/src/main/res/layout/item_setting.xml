<?xml version="1.0" encoding="utf-8"?>
<!-- One settings row: what it is and what it does on the left, its current value on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/tv_row_bg"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingTop="20dp"
    android:paddingEnd="28dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setting_title"
            style="@style/TvText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_medium"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/setting_summary"
            style="@style/TvText.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/setting_value"
        style="@style/TvText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:fontFamily="@font/outfit_medium"
        android:textSize="19sp" />
</LinearLayout>
