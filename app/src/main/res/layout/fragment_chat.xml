<?xml version="1.0" encoding="utf-8"?>
<!-- One chat: its videos as a 16:9 grid (or, with Show messages on, all its messages as a list); the focused
     item's title and details above it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <com.vuegram.presentation.ui.GlowView
        android:id="@+id/glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The focused video's picture, softened, behind the top right; it takes its own size (Backdrop.onMeasure). -->
    <com.vuegram.presentation.ui.Backdrop
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="40dp"
        android:paddingEnd="72dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Does what the remote's Back does: for people who look for a button on screen. -->
            <ImageButton
                android:id="@+id/back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/tv_round_button_bg"
                android:contentDescription="@string/nav_back"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back" />

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/tv_avatar_bg"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Long channel names get a second line rather than being cut after a few words. The name sits next to
                     the photo in any script (viewStart), not across the header for a Hebrew name in an English VueGram. -->
                <TextView
                    android:id="@+id/chat_title"
                    style="@style/TvText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_medium"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:textSize="@dimen/text_title" />

                <com.vuegram.presentation.ui.EyebrowText
                    android:id="@+id/chat_kind"
                    style="@style/TvText.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAlignment="viewStart" />
            </LinearLayout>

            <!-- Newest first / Oldest first: the order of this chat's videos, remembered per chat (ChatOrder). Hidden
                 in search results and with Show messages on. -->
            <Button
                android:id="@+id/order"
                style="@style/TvText"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/tv_button_bg"
                android:drawableStart="@drawable/ic_sort"
                android:drawablePadding="10dp"
                android:drawableTint="@color/tv_button_text"
                android:fontFamily="@font/outfit_medium"
                android:paddingStart="18dp"
                android:paddingEnd="22dp"
                android:textAllCaps="false"
                android:textColor="@color/tv_button_text"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <!-- "Connecting…" / "Waiting for network…": only while VueGram is not connected to Telegram. -->
            <TextView
                android:id="@+id/connection"
                style="@style/TvText.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="@drawable/tv_pill_bg"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textSize="@dimen/text_label"
                android:visibility="gone" />

            <!-- Voice search: shown only when the TV has speech recognition. -->
            <ImageButton
                android:id="@+id/voice"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/tv_round_button_bg"
                android:contentDescription="@string/voice_search"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                android:visibility="gone" />

            <!-- Search this chat: a round button that widens into the search box when focused (ExpandingSearch); OK
                 opens the keyboard. -->
            <EditText
                android:id="@+id/search"
                style="@style/TvText"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/tv_search_bg"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:hint="@string/search_chat_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColorHint="@color/tv_text_dim"
                android:textSize="@dimen/text_body" />

            <TextClock
                style="@style/TvText.Clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm" />
        </LinearLayout>

        <TextView
            android:id="@+id/video_title"
            style="@style/TvText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_light"
            android:maxLines="1"
            android:textSize="@dimen/text_headline" />

        <TextView
            android:id="@+id/video_meta"
            style="@style/TvText.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2" />

        <FrameLayout
            android:id="@+id/grid_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="-24dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-24dp"
            android:layout_weight="1">

            <!-- The container clips the grid at its own edge, so scrolled rows never draw over the title; the
                 grid's padding leaves room inside that edge for the zoomed card and the focus ring. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="60dp"
                android:scrollbars="none" />

            <!-- Grey video cards with a soft shimmer until the first page arrives (SkeletonView). -->
            <com.vuegram.presentation.ui.SkeletonView
                android:id="@+id/skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="36dp"
                android:paddingTop="36dp"
                android:paddingRight="36dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Loading, empty and error messages; Retry shows only after an error. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            style="@style/TvText.Sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="720dp"
            android:textAlignment="center" />

        <Button
            android:id="@+id/retry"
            style="@style/TvText"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/tv_button_bg"
            android:fontFamily="@font/outfit_medium"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/action_retry"
            android:textAllCaps="false"
            android:textColor="@color/tv_button_text"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
