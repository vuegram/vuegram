<?xml version="1.0" encoding="utf-8"?>
<!-- The built-in player: the picture, and an overlay (title, channel, progress, times) that hides itself. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/black"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/player_buffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_gravity="bottom"
            android:background="@drawable/tv_player_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingBottom="56dp">

            <com.vuegram.presentation.ui.EyebrowText
                android:id="@+id/player_chat"
                style="@style/TvText.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />

            <TextView
                android:id="@+id/player_title"
                style="@style/TvText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_light"
                android:maxLines="2"
                android:textSize="30sp" />

            <!-- While left/right are pressed: where the jump will land, e.g. "+1:30  ·  12:34". -->
            <TextView
                android:id="@+id/player_seek"
                style="@style/TvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/outfit_medium"
                android:textSize="22sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/player_state"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pause" />

                <TextView
                    android:id="@+id/player_position"
                    style="@style/TvText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/outfit_medium"
                    android:minWidth="88dp"
                    android:textSize="18sp" />

                <ProgressBar
                    android:id="@+id/player_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/tv_player_progress" />

                <TextView
                    android:id="@+id/player_duration"
                    style="@style/TvText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_medium"
                    android:minWidth="88dp"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/tv_text_dim"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- Down (or the remote's Menu key) opens subtitles, audio, speed and the sleep timer. -->
            <TextView
                style="@style/TvText.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/player_options_hint"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- "Up next": shown when a video ends and Play next is on; OK plays it now, Back stops. -->
    <LinearLayout
        android:id="@+id/player_up_next"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/tv_card_bg"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <com.vuegram.presentation.ui.EyebrowText
            style="@style/TvText.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/player_up_next" />

        <TextView
            android:id="@+id/player_up_next_title"
            style="@style/TvText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_light"
            android:maxLines="2"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/player_up_next_count"
            style="@style/TvText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/outfit_medium"
            android:textSize="18sp" />

        <TextView
            style="@style/TvText.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/player_up_next_hint"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
