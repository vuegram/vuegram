<?xml version="1.0" encoding="utf-8"?>
<!-- A photo from a chat, full screen. Left/right move to the chat's other photos; Back closes it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <ProgressBar
        android:id="@+id/photo_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/tv_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/tv_player_scrim"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="48dp"
        android:paddingEnd="72dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/photo_caption"
            style="@style/TvText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/photo_meta"
            style="@style/TvText.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</FrameLayout>
