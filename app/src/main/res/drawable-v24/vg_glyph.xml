            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="36" android:startY="28" android:endX="81" android:endY="80"
                    android:startColor="#FF7C3AED" android:endColor="#FF4C1D95" />
            </aapt:attr>
    </path>
    <path android:pathData="M40,30 Q36,28 36,33 V75 Q36,80 40,78 L53,58 Z">
            <aapt:attr name="android:fillColor">
