    <string name="onboarding_welcome_title">VueGram में आपका स्वागत है</string>
    <string name="onboarding_welcome_body">आपके Telegram चैनल और ग्रुप, बड़ी स्क्रीन पर। सेटअप में लगभग दो मिनट लगते हैं: पहले आपकी Telegram API कीज़, फिर फ़ोन से स्कैन करने के लिए एक QR कोड।</string>
    <string name="onboarding_get_started">शुरू करें</string>
    <string name="onboarding_language">भाषा: %1$s</string>
    <string name="onboarding_keys_title">आपकी Telegram API कीज़</string>
    <string name="onboarding_keys_body">VueGram आपकी अपनी API ID और hash से Telegram से कनेक्ट होता है। ये मुफ़्त हैं: my.telegram.org पर अपने फ़ोन नंबर से लॉग इन करें, API development tools खोलें और एक ऐप बनाएँ (कोई भी नाम चलेगा)। फिर ये दोनों वैल्यू इस टीवी पर भेजें।</string>
    <string name="onboarding_keys_qr_caption">अपने फ़ोन के कैमरे से स्कैन करें। एक पेज खुलेगा, जहाँ आप कीज़ लेकर इस टीवी पर भेज सकते हैं। आपका फ़ोन उसी Wi-Fi पर होना चाहिए।</string>
    <string name="onboarding_type_keys">रिमोट से टाइप करें</string>
    <string name="onboarding_send_from_phone">मेरे फ़ोन से भेजें</string>
    <string name="onboarding_continue">जारी रखें</string>
    <string name="onboarding_error_api_id">API ID एक नंबर होता है, जैसे 1234567।</string>
    <string name="onboarding_error_api_hash">API hash में 32 अक्षर और अंक होते हैं (0–9 और a–f)।</string>
    <string name="onboarding_qr_caption">जब तक आप स्कैन नहीं करते, यह कोड अपने-आप बदलता रहता है।</string>
    <string name="onboarding_use_phone">इसकी जगह फ़ोन नंबर इस्तेमाल करें</string>
    <string name="onboarding_phone_title">आपका फ़ोन नंबर</string>
    <string name="onboarding_phone_body">देश के कोड के साथ, जैसे +1 555 123 4567। Telegram आपको साइन इन करने के लिए एक कोड भेजेगा।</string>
    <string name="onboarding_send_code">कोड भेजें</string>
    <string name="onboarding_code_app">Telegram ने कोड आपके दूसरे डिवाइस पर Telegram ऐप में भेजा है। Telegram का मैसेज देखें।</string>
    <string name="onboarding_code_sms">Telegram ने कोड SMS से भेजा है।</string>
    <string name="onboarding_code_other">Telegram ने जो कोड भेजा है, उसे डालें।</string>
    <string name="onboarding_sign_in">साइन इन करें</string>
    <string name="onboarding_password_body">आपके अकाउंट में दो-चरणीय सत्यापन चालू है, इसलिए Telegram उसका पासवर्ड भी माँगता है।</string>
    <string name="onboarding_password_hint_is">आपका हिंट: %1$s</string>
    <string name="onboarding_blocked_title">इसकी जगह QR कोड से साइन इन करें</string>
    <string name="onboarding_blocked_no_account">इस नंबर पर अभी कोई Telegram अकाउंट नहीं है। पहले Telegram ऐप में साइन अप करें, या जिस फ़ोन में Telegram है उससे QR कोड स्कैन करें।</string>
    <string name="onboarding_bad_keys_title">Telegram ने ये कीज़ स्वीकार नहीं कीं</string>
    <string name="onboarding_error_phone">यह नंबर सही नहीं लग रहा। देश का कोड भी डालें, जैसे +1।</string>
    <string name="onboarding_error_code">यह कोड सही नहीं है। चेक करके फिर से कोशिश करें।</string>
    <string name="onboarding_error_code_expired">इस कोड की समय-सीमा खत्म हो गई है। वापस जाकर नया कोड माँगें।</string>
    <string name="onboarding_error_password">यह पासवर्ड सही नहीं है।</string>
    <string name="keydrop_title">अपनी API कीज़ टीवी पर भेजें</string>
    <string name="keydrop_intro">इन्हें Telegram से लें, फिर नीचे पेस्ट करें। ये आपके Wi-Fi से सीधे आपके टीवी पर जाती हैं।</string>
    <string name="keydrop_open_site">my.telegram.org खोलें</string>
    <string name="keydrop_site_steps">अपने फ़ोन नंबर से लॉग इन करें, API development tools खोलें, एक ऐप बनाएँ (कोई भी नाम), फिर App api_id और App api_hash कॉपी करें।</string>
    <string name="keydrop_send">टीवी पर भेजें</string>
