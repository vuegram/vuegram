    <string name="onboarding_ready">وارد شدید</string>
    <string name="onboarding_welcome_title">به VueGram خوش آمدید</string>
    <string name="onboarding_welcome_body">کانال‌ها و گروه‌های تلگرام شما، روی صفحه بزرگ. راه‌اندازی حدود دو دقیقه طول می‌کشد: اول کلیدهای API تلگرام شما، بعد یک کد QR که با گوشی‌تان اسکن می‌کنید.</string>
    <string name="onboarding_get_started">شروع کنیم</string>
    <string name="onboarding_language">زبان: %1$s</string>
    <string name="onboarding_keys_title">کلیدهای API تلگرام شما</string>
    <string name="onboarding_keys_body">برنامه VueGram با API ID و API hash خودتان به تلگرام وصل می‌شود. هر دو رایگان‌اند: در my.telegram.org با شماره تلفن‌تان وارد شوید، API development tools را باز کنید و یک برنامه بسازید (هر نامی باشد کافی است). سپس این دو مقدار را به این تلویزیون بفرستید.</string>
    <string name="onboarding_keys_qr_caption">با دوربین گوشی‌تان اسکن کنید. صفحه‌ای باز می‌شود که در آن می‌توانید کلیدها را بگیرید و به این تلویزیون بفرستید. گوشی باید به همان Wi-Fi وصل باشد.</string>
    <string name="onboarding_type_keys">وارد کردن با کنترل</string>
    <string name="onboarding_send_from_phone">فرستادن از گوشی من</string>
    <string name="onboarding_continue">ادامه</string>
    <string name="onboarding_error_api_id">مقدار API ID یک عدد است، مثل 1234567.</string>
    <string name="onboarding_error_api_hash">مقدار API hash از ۳۲ حرف و رقم تشکیل شده است: رقم‌های 0 تا 9 و حروف a تا f.</string>
    <string name="onboarding_qr_caption">کد تا وقتی اسکنش نکنید، خودبه‌خود تازه می‌شود.</string>
    <string name="onboarding_use_phone">ورود با شماره تلفن</string>
    <string name="onboarding_phone_title">شماره تلفن شما</string>
    <string name="onboarding_phone_body">همراه با کد کشور، مثل ‎+1 555 123 4567. تلگرام برای ورود کدی برایتان می‌فرستد.</string>
    <string name="onboarding_send_code">فرستادن کد</string>
    <string name="onboarding_code_app">تلگرام کد را به برنامه تلگرام شما روی دستگاه دیگری فرستاد. دنبال پیامی از طرف تلگرام بگردید.</string>
    <string name="onboarding_code_sms">تلگرام کد را با پیامک فرستاد.</string>
    <string name="onboarding_code_other">کدی را که تلگرام برایتان فرستاد وارد کنید.</string>
    <string name="onboarding_sign_in">ورود</string>
    <string name="onboarding_password_body">حساب شما تأیید دو مرحله‌ای دارد، پس تلگرام رمز آن را هم می‌خواهد.</string>
    <string name="onboarding_password_hint_is">راهنمای رمز شما: %1$s</string>
    <string name="onboarding_blocked_title">به‌جای آن با کد QR وارد شوید</string>
    <string name="onboarding_blocked_no_account">این شماره هنوز حساب تلگرام ندارد. اول در برنامه تلگرام ثبت‌نام کنید، یا کد QR را با گوشی‌ای که تلگرام دارد اسکن کنید.</string>
    <string name="onboarding_bad_keys_title">تلگرام این کلیدها را نپذیرفت</string>
    <string name="onboarding_error_phone">این شماره درست به نظر نمی‌رسد. کد کشور را هم وارد کنید، مثل ‎+1.</string>
    <string name="onboarding_error_code">این کد درست نیست. آن را بررسی کنید و دوباره امتحان کنید.</string>
    <string name="onboarding_error_code_expired">این کد منقضی شده است. برگردید و کد تازه‌ای بخواهید.</string>
    <string name="onboarding_error_password">این رمز درست نیست.</string>
    <string name="keydrop_title">کلیدهای API را به تلویزیون بفرستید</string>
    <string name="keydrop_intro">آن‌ها را از تلگرام بگیرید و پایین همین صفحه بچسبانید. مستقیم از راه Wi-Fi شما به تلویزیون می‌رسند.</string>
    <string name="keydrop_open_site">باز کردن my.telegram.org</string>
    <string name="keydrop_site_steps">با شماره تلفن‌تان وارد شوید، API development tools را باز کنید، یک برنامه بسازید (با هر نامی)، سپس App api_id و App api_hash را کپی کنید.</string>
    <string name="keydrop_send">فرستادن به تلویزیون</string>
    <string name="keydrop_sent">فرستاده شد. می‌توانید گوشی را کنار بگذارید و روی تلویزیون ادامه دهید.</string>
    <string name="keydrop_invalid">درست به نظر نمی‌رسد: API ID یک عدد است و API hash از ۳۲ حرف و رقم تشکیل شده است.</string>
