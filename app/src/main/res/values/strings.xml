    <string name="onboarding_welcome_title">Welcome to VueGram</string>
    <string name="onboarding_welcome_body">Your Telegram channels and groups, on the big screen. Setting up takes about two minutes: your Telegram API keys, then a QR code to scan with your phone.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_language">Language: %1$s</string>
    <string name="onboarding_keys_title">Your Telegram API keys</string>
    <string name="onboarding_keys_body">VueGram connects to Telegram with your own API ID and hash. They\'re free: on my.telegram.org, log in with your phone number, open API development tools and create an app (any name will do). Then send the two values to this TV.</string>
    <string name="onboarding_keys_qr_caption">Scan with your phone\'s camera. A page opens where you can get the keys and send them to this TV. Your phone needs to be on the same Wi-Fi.</string>
    <string name="onboarding_type_keys">Type them with the remote</string>
    <string name="onboarding_send_from_phone">Send them from my phone</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_error_api_id">The API ID is a number, like 1234567.</string>
    <string name="onboarding_error_api_hash">The API hash is 32 letters and digits (0–9 and a–f).</string>
    <string name="onboarding_qr_caption">The code refreshes by itself until you scan it.</string>
    <string name="onboarding_use_phone">Use a phone number instead</string>
    <string name="onboarding_phone_title">Your phone number</string>
    <string name="onboarding_phone_body">With the country code, like +1 555 123 4567. Telegram sends you a code to sign in.</string>
    <string name="onboarding_send_code">Send code</string>
    <string name="onboarding_code_app">Telegram sent the code to your Telegram app on another device. Look for a message from Telegram.</string>
    <string name="onboarding_code_sms">Telegram sent the code by SMS.</string>
    <string name="onboarding_code_other">Enter the code Telegram sent you.</string>
    <string name="onboarding_sign_in">Sign in</string>
    <string name="onboarding_password_body">Your account has 2-step verification, so Telegram asks for its password too.</string>
    <string name="onboarding_password_hint_is">Your hint: %1$s</string>
    <string name="onboarding_blocked_title">Sign in with a QR code instead</string>
    <string name="onboarding_blocked_no_account">This number has no Telegram account yet. Sign up in the Telegram app first, or scan a QR code with a phone that has Telegram.</string>
    <string name="onboarding_bad_keys_title">Telegram didn\'t accept these keys</string>
    <string name="onboarding_error_phone">That number doesn\'t look right. Include the country code, like +1.</string>
    <string name="onboarding_error_code">That code isn\'t right. Check it and try again.</string>
    <string name="onboarding_error_code_expired">That code has expired. Go back and ask for a new one.</string>
    <string name="onboarding_error_password">That password isn\'t right.</string>

    <string name="keydrop_title">Send your API keys to the TV</string>
    <string name="keydrop_intro">Get them from Telegram, then paste them below. They go straight to your TV over your Wi-Fi.</string>
    <string name="keydrop_open_site">Open my.telegram.org</string>
    <string name="keydrop_site_steps">Log in with your phone number, open API development tools, create an app (any name), then copy the App api_id and App api_hash.</string>
    <string name="keydrop_send">Send to TV</string>
    <string name="keydrop_sent">Sent. You can put your phone away and continue on the TV.</string>
    <string name="keydrop_invalid">That doesn\'t look right: the API ID is a number, the API hash 32 letters and digits.</string>

