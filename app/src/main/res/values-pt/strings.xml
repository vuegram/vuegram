    <string name="onboarding_qr_caption">O código se atualiza sozinho até você escanear.</string>
    <string name="onboarding_use_phone">Usar um número de telefone</string>
    <string name="onboarding_phone_title">Seu número de telefone</string>
    <string name="onboarding_phone_body">Com o código do país, como +1 555 123 4567. O Telegram vai enviar um código para você entrar.</string>
    <string name="onboarding_send_code">Enviar código</string>
    <string name="onboarding_code_app">O Telegram enviou o código para o seu app do Telegram em outro dispositivo. Procure uma mensagem do Telegram.</string>
