    <string name="onboarding_code_other">Digite o código que o Telegram enviou para você.</string>
    <string name="onboarding_sign_in">Entrar</string>
    <string name="onboarding_password_body">Sua conta tem a Verificação em Duas Etapas, então o Telegram pede a senha dela também.</string>
