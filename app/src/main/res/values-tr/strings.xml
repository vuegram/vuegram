    <string name="onboarding_send_from_phone">Telefonumdan gönder</string>
    <string name="onboarding_continue">Devam et</string>
    <string name="onboarding_error_api_id">API ID bir sayıdır, örneğin 1234567.</string>
    <string name="onboarding_error_api_hash">API hash 32 harf ve rakamdan oluşur (0–9 ve a–f).</string>
    <string name="onboarding_qr_caption">Kod, siz tarayana kadar kendiliğinden yenilenir.</string>
    <string name="onboarding_use_phone">Bunun yerine telefon numarası kullan</string>
    <string name="onboarding_phone_title">Telefon numaranız</string>
    <string name="onboarding_phone_body">Ülke koduyla birlikte girin, örneğin +1 555 123 4567. Telegram size giriş için bir kod gönderir.</string>
    <string name="onboarding_send_code">Kod gönder</string>
    <string name="onboarding_code_app">Telegram, kodu başka bir cihazdaki Telegram uygulamanıza gönderdi. Telegram\'dan gelen mesaja bakın.</string>
    <string name="onboarding_code_sms">Telegram, kodu SMS ile gönderdi.</string>
    <string name="onboarding_code_other">Telegram\'ın size gönderdiği kodu girin.</string>
    <string name="onboarding_sign_in">Giriş yap</string>
    <string name="onboarding_password_body">Hesabınızda İki Adımlı Doğrulama açık, bu yüzden Telegram şifresini de istiyor.</string>
    <string name="onboarding_password_hint_is">İpucunuz: %1$s</string>
    <string name="onboarding_blocked_title">Bunun yerine QR kodla giriş yapın</string>
    <string name="onboarding_blocked_no_account">Bu numaranın henüz Telegram hesabı yok. Önce Telegram uygulamasında kaydolun ya da Telegram yüklü bir telefonla QR kodu tarayın.</string>
    <string name="onboarding_bad_keys_title">Telegram bu anahtarları kabul etmedi</string>
