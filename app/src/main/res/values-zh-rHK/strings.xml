    <string name="onboarding_language">語言：%1$s</string>
    <string name="onboarding_keys_title">你的 Telegram API 金鑰</string>
    <string name="onboarding_keys_body">VueGram 會用你自己的 API ID 和 Hash 連上 Telegram。它們是免費的：在 my.telegram.org 用手機號碼登入，開啟 API development tools 並建立一個應用程式（名稱不拘），然後把這兩個值傳送到這台電視。</string>
    <string name="onboarding_keys_qr_caption">用手機相機掃描。接著會開啟一個網頁，你可以在那裡取得金鑰並傳送到這台電視。手機必須連上同一個 Wi-Fi。</string>
    <string name="onboarding_type_keys">用遙控器輸入</string>
    <string name="onboarding_send_from_phone">從手機傳送</string>
    <string name="onboarding_continue">繼續</string>
    <string name="onboarding_error_api_id">API ID 是一串數字，例如 1234567。</string>
    <string name="onboarding_error_api_hash">API Hash 由 32 個字母和數字組成（0–9 和 a–f）。</string>
    <string name="onboarding_qr_caption">這個 QR 碼會自動更新，直到你掃描為止。</string>
