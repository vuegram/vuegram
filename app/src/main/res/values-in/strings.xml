    <string name="onboarding_welcome_title">Selamat datang di VueGram</string>
    <string name="onboarding_welcome_body">Channel dan grup Telegram Anda, di layar besar. Penyiapannya sekitar dua menit: kunci API Telegram Anda, lalu kode QR untuk dipindai dengan ponsel.</string>
