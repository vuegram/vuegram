    <string name="onboarding_qr_caption">Kode ini diperbarui otomatis sampai Anda memindainya.</string>
    <string name="onboarding_use_phone">Pakai nomor telepon saja</string>
    <string name="onboarding_phone_title">Nomor telepon Anda</string>
    <string name="onboarding_phone_body">Dengan kode negara, misalnya +1 555 123 4567. Telegram akan mengirimkan kode untuk masuk.</string>
    <string name="onboarding_send_code">Kirim kode</string>
    <string name="onboarding_code_app">Telegram mengirim kode ke aplikasi Telegram Anda di perangkat lain. Cari pesan dari Telegram.</string>
    <string name="onboarding_code_sms">Telegram mengirim kode lewat SMS.</string>
    <string name="onboarding_code_other">Masukkan kode yang dikirim Telegram.</string>
    <string name="onboarding_sign_in">Masuk</string>
    <string name="onboarding_password_body">Akun Anda memakai Verifikasi Dua Langkah, jadi Telegram juga meminta kata sandinya.</string>
    <string name="onboarding_password_hint_is">Petunjuk Anda: %1$s</string>
    <string name="onboarding_blocked_title">Masuk dengan kode QR saja</string>
    <string name="onboarding_blocked_no_account">Nomor ini belum punya akun Telegram. Daftar dulu di aplikasi Telegram, atau pindai kode QR dengan ponsel yang sudah ada Telegram.</string>
    <string name="onboarding_bad_keys_title">Telegram tidak menerima kunci ini</string>
