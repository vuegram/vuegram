<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Installing VueGram's own updates (verified APKs from its GitHub releases); Android still asks first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only to tell whether the connection is metered, so updates aren't downloaded on a capped plan without asking. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ hides other apps unless declared: without this VueGram cannot see mpv (the fallback player). -->
    <queries>
        <package android:name="is.xyz.mpv" />
        <!-- Voice search: the TV's speech recognizer, which Android 11+ hides unless declared. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- No backups: the Telegram login (TDLib's session), the API keys and the watch history stay on this TV. -->
    <application
        android:name=".app.VueGramApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:localeConfig="@xml/locales_config"
        android:banner="@drawable/vg_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.VueGram">
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The built-in player; only VueGram itself opens it. -->
        <activity
            android:name=".presentation.player.PlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.VueGram.Player" />

        <receiver
            android:name=".data.update.InstallStatusReceiver"
            android:exported="false" />

        <service
            android:name=".data.stream.StreamKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>